#!/bin/bash
set -euo pipefail

# Installer runs as root. Launch the menu-bar app as the logged-in console user
# so SMAppService can register the login item for that account.
DEST_VOLUME="${2:-/}"
APP_PATH="${DEST_VOLUME%/}/Applications/SleepMaster.app"
CONSOLE_USER="$(stat -f '%Su' /dev/console)"
if [[ -n "${CONSOLE_USER}" && "${CONSOLE_USER}" != "root" && -d "${APP_PATH}" ]]; then
    sudo -u "${CONSOLE_USER}" open -a "${APP_PATH}" || true
fi

exit 0
