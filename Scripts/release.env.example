# Local only. Copy to Scripts/release.env (gitignored).
# TEAM_ID is your 10-character Apple Developer Team ID.
# NOTARY_PROFILE is the name you passed to: xcrun notarytool store-credentials

TEAM_ID=YOUR_TEAM_ID
NOTARY_PROFILE=YOUR_NOTARY_PROFILE

# Sparkle (optional). Public EdDSA key from generate_keys; never commit the private key.
# SU_FEED_URL=https://example.com/sleepmaster/appcast.xml
# SU_PUBLIC_ED_KEY=
